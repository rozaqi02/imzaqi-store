# ── Supabase ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── QRIS ─────────────────────────────────────────────────────────
VITE_QRIS_BASE=your-qris-base-payload

# ── AI Assistant ──────────────────────────────────────────────────
# Production: leave VITE_AI_* empty and set server-only vars on Netlify
# so the key never ships in the browser bundle.
#   AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   AI_KEY=your-ai-key
#   AI_MODEL=gemini-2.5-flash
#
# Local direct (optional, key will be in the Vite client bundle — avoid in prod):
# VITE_AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# VITE_AI_KEY=your-ai-key
# VITE_AI_MODEL=gemini-2.5-flash
# Force proxy even in dev: VITE_AI_USE_PROXY=1
