# ── Supabase ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── QRIS ─────────────────────────────────────────────────────────
VITE_QRIS_BASE=your-qris-base-payload

# ── Notifikasi WhatsApp Order Real-time (Netlify Function) ───────
# Provider: fonnte | callmebot | meta
WA_PROVIDER=fonnte
# Bisa diisi nomor WA (6283136049987) atau ID Grup WhatsApp (120363xxxxxxxxxx@g.us)
WA_ADMIN_PHONE=6283136049987
WA_API_TOKEN=your-whatsapp-gateway-token
WA_WEBHOOK_SECRET=your-random-webhook-secret
# all | insert | paid_reported
WA_NOTIFY_ON=all
# Khusus WA_PROVIDER=meta:
# WA_META_PHONE_NUMBER_ID=your-meta-phone-number-id
